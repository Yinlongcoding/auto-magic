{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auto Magic common rule file v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "moduleId",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "moduleId": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "rule-file.schema.json#/properties/rules/items"
      }
    }
  }
}
