<Window x:Class="AutoMagic.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Magic"
        Width="1280"
        Height="900"
        MinWidth="1080"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
        <Style x:Key="WorkspaceChrome" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCleaningExpanded}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WrappedCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Padding" Value="8,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="InspectionGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC" />
            <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="24,10" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#E8EEF8" />
            <Setter Property="Foreground" Value="#1D4ED8" />
        </Style>
        <Style x:Key="NumericTextBoxStyle" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="Language" Value="en-US" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="MinWidth" Value="92" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="20" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCleaningExpanded}" Value="True">
                        <Setter Property="Margin" Value="10" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18" Style="{StaticResource WorkspaceChrome}">
            <TextBlock Text="Auto Magic" FontSize="30" FontWeight="SemiBold" Foreground="#111827" />
            <TextBlock Text="在桌面端发起 1688 搜索，并接收 Chrome 插件采集的数据"
                       Margin="0,6,0,0" FontSize="14" Foreground="#6B7280" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource WorkspaceChrome}" Padding="18" Background="White" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Microsoft YaHei UI"
                         FontSize="16"
                         Padding="12,10"
                         Margin="0,0,12,0"
                         VerticalContentAlignment="Center"
                         ToolTip="输入搜索关键词" />
                <ComboBox Grid.Column="1"
                          Width="138"
                          Margin="0,0,12,0"
                          Padding="9,8"
                          FontFamily="Microsoft YaHei UI"
                          FontSize="14"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding SortOptions}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding SelectedSortMode, Mode=TwoWay}" />
                <Button Grid.Column="2"
                        Content="搜索并抓取"
                        Command="{Binding SearchCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource WorkspaceChrome}" Margin="0,14" Padding="14,10" Background="#E8EEF8" CornerRadius="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding ResultCount, StringFormat=结果：{0} 条}"
                           FontWeight="SemiBold"
                           Foreground="#1F2937" />
                <TextBlock Text="{Binding StatusText}" Foreground="#374151" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Expander Grid.Row="3" Style="{StaticResource WorkspaceChrome}"
                  Margin="0,0,0,14"
                  HorizontalContentAlignment="Stretch">
            <Expander.Header>
                <Border Padding="14,10" Background="#E8EEF8" CornerRadius="8">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="点击折叠，释放下方数据区域"
                                   Foreground="#6B7280"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="汇率参考、成本核算与售价区间"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2937"
                                   FontSize="14" />
                    </DockPanel>
                </Border>
            </Expander.Header>
            <Border Padding="18" Margin="0,8,0,0" Background="White" CornerRadius="10">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right"
                                Content="刷新"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RefreshExchangeRatesCommand}" />
                        <TextBlock Text="今日参考汇率" Style="{StaticResource SectionTitleStyle}" Margin="0" />
                    </DockPanel>
                    <Border Background="#F8FAFC" CornerRadius="7" Padding="12" Margin="0,0,0,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="USD" Foreground="#6B7280" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="1 CNY = " Foreground="#6B7280" />
                                <TextBlock Text="{Binding CnyToUsdText}" FontWeight="SemiBold" Foreground="#111827" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Background="#F8FAFC" CornerRadius="7" Padding="12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="RUB" Foreground="#6B7280" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="1 CNY = " Foreground="#6B7280" />
                                <TextBlock Text="{Binding CnyToRubText}" FontWeight="SemiBold" Foreground="#111827" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock Text="{Binding ExchangeRateStatus}"
                               Margin="0,9,0,0"
                               FontSize="11"
                               Foreground="#6B7280"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,24,0">
                    <TextBlock Text="成本核算（CNY）" Style="{StaticResource SectionTitleStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="平台佣金比例" VerticalAlignment="Center" Margin="0,0,12,7" />
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,7,7"
                                 Style="{StaticResource NumericTextBoxStyle}"
                                 Text="{Binding CommissionRatePercent, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="0,0,0,7" />

                        <TextBlock Grid.Row="1" Text="平台佣金" VerticalAlignment="Center" Margin="0,0,12,7" />
                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Background="#F8FAFC" CornerRadius="5" Padding="9,7" Margin="0,0,0,7">
                            <TextBlock Text="{Binding CommissionCostText}" HorizontalAlignment="Right" Foreground="#374151" />
                        </Border>

                        <TextBlock Grid.Row="2" Text="目标利润" VerticalAlignment="Center" Margin="0,0,12,7" />
                        <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Background="#F8FAFC" CornerRadius="5" Padding="9,7" Margin="0,0,0,7">
                            <TextBlock Text="{Binding TargetProfitCostText}" HorizontalAlignment="Right" Foreground="#374151" />
                        </Border>

                        <TextBlock Grid.Row="3" Text="物流费用" VerticalAlignment="Center" Margin="0,0,12,7" />
                        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,7"
                                 Style="{StaticResource NumericTextBoxStyle}"
                                 Text="{Binding LogisticsCostCny, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />

                        <TextBlock Grid.Row="4" Text="采购成本" VerticalAlignment="Center" Margin="0,0,12,7" />
                        <Border Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                                Background="#F8FAFC" CornerRadius="5" Padding="9,7" Margin="0,0,0,7"
                                ToolTip="售价扣除平台佣金、目标利润、物流、广告推广和其他费用后的可采购成本区间">
                            <TextBlock Text="{Binding ProcurementCostText}" HorizontalAlignment="Right" Foreground="#374151" />
                        </Border>

                        <TextBlock Grid.Row="5" Text="广告推广" VerticalAlignment="Center" Margin="0,0,12,7" />
                        <TextBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,7"
                                 Style="{StaticResource NumericTextBoxStyle}"
                                 Text="{Binding AdvertisingCostCny, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />

                        <TextBlock Grid.Row="6" Text="其他" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                                 Style="{StaticResource NumericTextBoxStyle}"
                                 Text="{Binding OtherCostCny, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="目标利润率"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#374151" />
                        <Slider Grid.Column="1"
                                Margin="14,0,10,0"
                                Minimum="0"
                                Maximum="100"
                                TickFrequency="1"
                                Value="{Binding TargetProfitRatePercent, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding TargetProfitRatePercent, StringFormat={}{0:0.##}%}"
                                   MinWidth="52"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   Foreground="#111827" />
                    </Grid>

                    <TextBlock Text="售价区间（CNY）" Style="{StaticResource SectionTitleStyle}" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource NumericTextBoxStyle}"
                                 Text="{Binding SalePriceMinimumCny, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, TargetNullValue=''}" />
                        <TextBlock Grid.Column="1" Text="—" Margin="10,0" VerticalAlignment="Center" Foreground="#6B7280" />
                        <TextBox Grid.Column="2"
                                 Style="{StaticResource NumericTextBoxStyle}"
                                 Text="{Binding SalePriceMaximumCny, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True, TargetNullValue=''}" />
                    </Grid>
                </StackPanel>
                </Grid>
            </Border>
        </Expander>

        <TabControl x:Name="WorkspaceTabs" Grid.Row="4" FontFamily="Microsoft YaHei UI" FontSize="14"
                    SelectedIndex="{Binding SelectedMainTabIndex, Mode=TwoWay}">
            <TabControl.Style>
                <Style TargetType="TabControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCleaningExpanded}" Value="True">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabControl">
                                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <ContentPresenter ContentSource="SelectedContent" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Style>
            <TabItem Header="商品列表">
                <DataGrid ItemsSource="{Binding Products}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          AlternatingRowBackground="#F8FAFC"
                          HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称" Binding="{Binding Title}" Width="2.0*" />
                        <DataGridTextColumn Header="抓取价格" Binding="{Binding PriceCny}" Width="0.7*" />
                        <DataGridTextColumn Header="图片地址" Binding="{Binding ImageUrl}" Width="1.2*" />
                        <DataGridTextColumn Header="详情链接" Binding="{Binding DetailUrl}" Width="1.4*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="原始 JSON">
                <TextBox Text="{Binding RawJson}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         FontSize="13"
                         Padding="12"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" />
            </TabItem>
            <TabItem Header="数据清洗">
                <Grid x:Name="CleaningWorkspace" Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="详情商品" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding CleaningProducts}"
                                  SelectedItem="{Binding SelectedCleaningDetail, Mode=TwoWay}"
                                  DisplayMemberPath="ProductTitle" Padding="8,6" Margin="0,0,12,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="执行数据清洗" Command="{Binding CleanProductCommand}" Padding="16,7" Margin="0,0,8,0" />
                            <Button Command="{Binding ToggleCleaningExpandedCommand}" ToolTip="隐藏顶部搜索和成本区域，使用整个应用内容区">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Content" Value="铺满窗口" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCleaningExpanded}" Value="True">
                                                <Setter Property="Content" Value="退出放大" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding CleaningSourceStatus}" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TabControl x:Name="CleaningViews" Grid.Row="2" SelectedIndex="{Binding SelectedCleaningTabIndex, Mode=TwoWay}">
                        <TabItem Header="数据清洗 JSON">
                            <DockPanel Margin="8">
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="{Binding CleaningStatus}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <DockPanel Margin="0,0,0,10">
                                        <Button DockPanel.Dock="Right" Content="导出清洗 JSON" Command="{Binding ExportCleanedProductCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" />
                                        <CheckBox Content="查看完整 JSON" IsChecked="{Binding ShowCleaningJson}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                                <Grid>
                                    <DataGrid x:Name="CleaningResultsGrid" ItemsSource="{Binding CleaningRows}">
                                        <DataGrid.Resources>
                                            <Style TargetType="DataGridRow">
                                                <Setter Property="ToolTip" Value="{Binding Detail}" />
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Style>
                                            <Style TargetType="DataGrid" BasedOn="{StaticResource InspectionGrid}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowCleaningJson}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.Style>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="属性 ID" Binding="{Binding Id}" Width="82" ElementStyle="{StaticResource WrappedCell}" />
                                            <DataGridTextColumn Header="属性" Binding="{Binding Name}" Width="140" ElementStyle="{StaticResource WrappedCell}" />
                                            <DataGridTextColumn Header="源字段" Binding="{Binding SourceField}" Width="100" ElementStyle="{StaticResource WrappedCell}" />
                                            <DataGridTextColumn Header="源值" Binding="{Binding SourceValue}" Width="*" ElementStyle="{StaticResource WrappedCell}" />
                                            <DataGridTextColumn Header="清洗值" Binding="{Binding Value}" Width="*" ElementStyle="{StaticResource WrappedCell}" />
                                            <DataGridTemplateColumn Header="结果来源" Width="100">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Resolution}" Foreground="{Binding StatusColor}" FontWeight="SemiBold" Padding="8,10" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBox Text="{Binding CleanedProductJson}" Visibility="{Binding ShowCleaningJson, Converter={StaticResource BooleanVisibility}}"
                                             IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" Padding="10"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                                </Grid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="源数据事实">
                            <DataGrid ItemsSource="{Binding SourceFacts}" Style="{StaticResource InspectionGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="源字段" Binding="{Binding Label}" Width="150" ElementStyle="{StaticResource WrappedCell}" />
                                    <DataGridTextColumn Header="原始值" Binding="{Binding Value}" Width="2*" ElementStyle="{StaticResource WrappedCell}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
            <TabItem Header="引擎设置">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16" Background="#F8FAFC" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Ozon 类目与 Schema 设置"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="测试期自动保存：API Key 存入当前 Windows 用户的 Credential Manager；Client ID 和已选品类/类型存入本地用户设置。不会传给 Native Host 或 Chrome 插件。"
                                       Margin="0,0,0,12"
                                       Foreground="#92400E"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding OzonCatalogStatus}"
                                       Margin="0,0,0,12"
                                       Foreground="#4B5563"
                                       TextWrapping="Wrap" />
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Client-Id" Margin="0,0,8,8" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Margin="0,0,18,8"
                                         Padding="8,6"
                                         Text="{Binding OzonClientId, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Api-Key" Margin="0,0,8,8" VerticalAlignment="Center" />
                                <PasswordBox x:Name="OzonApiKeyPasswordBox"
                                             Grid.Row="0"
                                             Grid.Column="3"
                                             Margin="0,0,18,8"
                                             Padding="8,6"
                                             PasswordChanged="OnOzonApiKeyPasswordChanged" />
                                <Button Grid.Row="0" Grid.Column="4"
                                        Content="清除凭证"
                                        Margin="0,0,0,8"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="OnClearOzonCredentials" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ozon 品类" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          Margin="0,0,18,0"
                                          Padding="7,6"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          StaysOpenOnEdit="True"
                                          TextSearch.TextPath="DisplayName"
                                          ItemsSource="{Binding OzonCategoryOptions}"
                                          SelectedItem="{Binding SelectedOzonCategory, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          ToolTip="输入中文品类名称可快速定位" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="商品类型" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="1" Grid.Column="3"
                                          Margin="0,0,18,0"
                                          Padding="7,6"
                                          IsEditable="True"
                                          IsTextSearchEnabled="True"
                                          StaysOpenOnEdit="True"
                                          TextSearch.TextPath="DisplayName"
                                          ItemsSource="{Binding OzonTypeOptions}"
                                          SelectedItem="{Binding SelectedOzonType, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          ToolTip="先选择品类，再选择该品类下的商品类型" />
                                <Button Grid.Row="1" Grid.Column="4"
                                        Content="请求并刷新 Schema"
                                        Padding="14,7"
                                        Command="{Binding LoadOzonSchemaCommand}" />
                            </Grid>
                            <TextBlock Margin="0,10,0,0"
                                       Text="类目与类型用于选择清洗规则；清洗前会用 Schema（优先读取本地缓存）校验类型方案是否覆盖全部必填属性。"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="2,10">
                        <TextBlock Text="{Binding OzonSchemaStatus}"
                                   Foreground="#374151"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TabControl Grid.Row="2">
                        <TabItem Header="属性列表">
                    <DataGrid
                              ItemsSource="{Binding OzonAttributes}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              RowHeaderWidth="0"
                              AlternatingRowBackground="#F8FAFC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="属性 ID" Binding="{Binding Id}" Width="0.7*" />
                            <DataGridTextColumn Header="属性名称" Binding="{Binding Name}" Width="1.4*" />
                            <DataGridCheckBoxColumn Header="必填" Binding="{Binding IsRequired}" Width="0.5*" />
                            <DataGridCheckBoxColumn Header="变体" Binding="{Binding IsAspect}" Width="0.5*" />
                            <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="0.7*" />
                            <DataGridTextColumn Header="字典 ID" Binding="{Binding DictionaryId}" Width="0.8*" />
                            <DataGridTextColumn Header="分组" Binding="{Binding GroupName}" Width="1.1*" />
                            <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="2.0*" />
                        </DataGrid.Columns>
                    </DataGrid>
                        </TabItem>
                        <TabItem Header="Schema JSON">
                            <TextBox Text="{Binding OzonSchemaJson}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Padding="10"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" />
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

