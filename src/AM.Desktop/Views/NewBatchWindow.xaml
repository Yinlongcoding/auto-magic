<ui:FluentWindow x:Class="AM.Desktop.Views.NewBatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:AM.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:NewBatchViewModel}"
        Title="新建采集" Width="720" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <!-- 隐藏所有 NumberBox 的递增/递减按钮，基于 WPF-UI 默认样式 -->
        <Style TargetType="ui:NumberBox" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
            <Setter Property="SpinButtonPlacementMode" Value="Hidden" />
        </Style>
        <Style x:Key="FieldError" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="新建采集" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,8,24,20">
            <ui:Button Content="取消" Margin="0,0,8,0" Click="OnCancel" IsCancel="True" />
            <ui:Button Content="开始采集" Appearance="Primary" Icon="{ui:SymbolIcon Play24}"
                       Command="{Binding StartCommand}" IsDefault="True" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,8" Grid.IsSharedSizeScope="True">
                <TextBlock Text="基本信息" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="类目" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,8,12,0" />
                    <!-- 可编辑下拉框：输入文字按前缀定位 -->
                    <StackPanel Grid.Column="1" Margin="0,0,0,12">
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                  IsEditable="True" IsTextSearchEnabled="True" IsEnabled="{Binding HasCategories}"
                                  AutomationProperties.Name="类目" />
                        <DockPanel Margin="0,4,0,0">
                            <ui:Button DockPanel.Dock="Right" Content="{Binding RefreshCategoriesText}" Padding="8,2"
                                       Appearance="Transparent" Command="{Binding RefreshCategoriesCommand}" />
                            <ui:ProgressRing DockPanel.Dock="Right" Width="14" Height="14" IsIndeterminate="True" Margin="0,0,6,0"
                                             Visibility="{Binding IsRefreshingCategories, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding CategoryMessage}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CategoryFailed}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="类型" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,8,12,0" />
                    <StackPanel Grid.Column="4" Margin="0,0,0,12">
                        <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}"
                                  IsEditable="True" IsTextSearchEnabled="True" AutomationProperties.Name="类型" />
                        <TextBlock Text="{Binding TypeError}" Style="{StaticResource FieldError}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="关键词" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,8,12,0" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
                        <ui:TextBox PlaceholderText="1688 搜索关键词" AutomationProperties.Name="关键词"
                                    Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding KeywordError}" Style="{StaticResource FieldError}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="采集数量" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,8,12,0" />
                    <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,12">
                        <ui:NumberBox Minimum="1" Maximum="500" Value="{Binding TargetCount}" AutomationProperties.Name="采集数量" />
                        <TextBlock Text="{Binding CountError}" Style="{StaticResource FieldError}" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="排序" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort}" AutomationProperties.Name="排序方式" />
                </Grid>
                <TextBlock Text="定价参数" FontWeight="SemiBold" Margin="0,8,0,4" />
                <TextBlock Text="定价尚未实现：这些参数暂不保存、不参与采集，采集时不按价格筛选。" Margin="0,0,0,12"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Grid IsEnabled="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="佣金率 %" Style="{StaticResource FieldLabel}" />
                    <ui:NumberBox Grid.Column="1" Margin="0,0,0,12" AutomationProperties.Name="佣金率" />
                    <TextBlock Grid.Column="3" Text="物流成本 ¥" Style="{StaticResource FieldLabel}" />
                    <ui:NumberBox Grid.Column="4" Margin="0,0,0,12" AutomationProperties.Name="物流成本" />
                    <TextBlock Grid.Row="1" Text="目标利润 %" Style="{StaticResource FieldLabel}" />
                    <ui:NumberBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" AutomationProperties.Name="目标利润率" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="汇率 / 浮动%" Style="{StaticResource FieldLabel}" />
                    <Grid Grid.Row="1" Grid.Column="4" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:NumberBox AutomationProperties.Name="汇率" />
                        <ui:NumberBox Grid.Column="2" AutomationProperties.Name="汇率浮动百分比" />
                    </Grid>
                    <TextBlock Grid.Row="2" Text="利润率区间 %" Style="{StaticResource FieldLabel}" />
                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:NumberBox AutomationProperties.Name="利润率下限" />
                        <TextBlock Grid.Column="1" Text="到" VerticalAlignment="Center" Margin="8,0" />
                        <ui:NumberBox Grid.Column="2" AutomationProperties.Name="利润率上限" />
                    </Grid>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="售价区间 ₽" Style="{StaticResource FieldLabel}" />
                    <Grid Grid.Row="2" Grid.Column="4" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:NumberBox AutomationProperties.Name="售价下限" />
                        <TextBlock Grid.Column="1" Text="到" VerticalAlignment="Center" Margin="8,0" />
                        <ui:NumberBox Grid.Column="2" AutomationProperties.Name="售价上限" />
                    </Grid>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</ui:FluentWindow>
