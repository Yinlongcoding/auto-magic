{
  "manifest_version": 3,
  "name": "Auto Magic 1688 Collector",
  "version": "0.1.12",
  "description": "在用户当前 Chrome 中搜索1688并采集商品详情事实。",
  "permissions": [
    "alarms",
    "debugger",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.1688.com/*",
    "http://*.1688.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Auto Magic 1688 Collector",
    "default_popup": "popup.html"
  }
}
